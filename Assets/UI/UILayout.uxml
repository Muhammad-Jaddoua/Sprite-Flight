<ui:UXML xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" noNamespaceSchemaLocation="../../UIElementsSchema/UIElements.xsd" editor-extension-mode="False">
    <ui:Label text="Score: 0" name="ScoreLabel" style="top: 20px; align-self: center; font-size: 20px; color: rgb(255, 227, 113); -unity-font-style: bold; border-left-color: rgb(255, 227, 114); border-right-color: rgb(255, 227, 114); border-top-color: rgb(255, 227, 114); border-bottom-color: rgb(255, 227, 114); border-top-width: 3px; border-right-width: 3px; border-bottom-width: 3px; border-left-width: 3px; border-top-left-radius: 10px; border-top-right-radius: 10px; border-bottom-right-radius: 10px; border-bottom-left-radius: 10px; padding-left: 5px; padding-right: 5px;"/>
    <ui:Button text="Restart" name="RestartButton" style="align-self: center; position: absolute; top: 50%; color: rgb(255, 255, 255); background-color: rgb(255, 0, 0);"/>
</ui:UXML>
